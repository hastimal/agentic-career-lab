        GemmaLLM["Ollama Gemma 4:12b<br/>(Local AI Model)"]
        Evidence["Structured ResumeEvidence<br/>• Skills & Technologies<br/>• Projects & Experience<br/>• Education"]

        RawDoc --> Parser --> GemmaLLM --> Evidence
    end

    subgraph Stage2 ["Stage 2: Target Opportunity (Grounded)"]
        TargetRole["Selected Opportunity<br/>(e.g., AI Engineering Intern)"]
        Reqs["Opportunity Requirements<br/>• Required vs Preferred<br/>• Verifiable Source Link"]

        TargetRole --> Reqs
    end

    subgraph Stage3 ["Stage 3: Evidence Mapping & Gap Analysis (Deterministic Python)"]
        Matcher["RequirementMapper & SkillNormalizer"]
        StatusMatrix["Evidence Status Categorization<br/>✓ Demonstrated<br/>△ Partial<br/>✗ Missing"]
        GapPrioritizer["Priority Scoring<br/>High / Medium / Low"]

        Evidence --> Matcher
        Reqs --> Matcher
        Matcher --> StatusMatrix
        StatusMatrix --> GapPrioritizer
    end

    subgraph Stage4 ["Stage 4: Synthesis & Learning Plan (Cloud / Offline Hybrid)"]
        Consent{"User Cloud Consent"}
        GeminiSynthesizer["Gemini Flash (Cloud AI)<br/>(Context-Rich Synthesis)"]
        PythonSynthesizer["Deterministic Python Planner<br/>(Rule-Based Catalog Match)"]
        Catalog["Educational Resource Catalog"]

        GapPrioritizer --> Consent
        Consent -->|Consent Granted| GeminiSynthesizer
        Consent -->|Consent Declined| PythonSynthesizer
        Catalog --> PythonSynthesizer
        Catalog --> GeminiSynthesizer
    end

    subgraph Stage5 ["Stage 5: Compiled Career Action Plan"]
        ActionPlan["🎓 CareerActionPlan<br/>━━━━━━━━━━━━━━━━━━━━━<br/>1. Target Role & Verified Evidence<br/>2. Prioritized Skill Gaps (High / Med / Low)<br/>3. Weekly Learning Roadmap (2 or 4 Weeks)<br/>4. Hands-On Portfolio Project<br/>5. Curated Tutorials & Docs Links"]

        GeminiSynthesizer --> ActionPlan
        PythonSynthesizer --> ActionPlan
    end

