flowchart TD
    subgraph Host ["💻 Host Machine (macOS / Linux / Windows)"]
        Browser["🌐 Web Browser (http://localhost:8501)"]
        OllamaNative["🦙 Native Ollama Service (Port 11434)<br/>Metal GPU Accelerated on Apple Silicon"]
        GemmaNativeStorage["📦 Host Model Storage (~/.ollama)<br/>(gemma4:12b ~8.0 GB)"]
        OllamaNative <--> GemmaNativeStorage
    end

    subgraph DockerCompose ["🐳 Docker Compose Runtime Environment"]
        subgraph AppContainer ["agentic-career-lab-app (Python 3.11-slim)"]
            StreamlitServer["Streamlit UI Server<br/>Port 8501 (Non-root user)"]
            CoordEngine["Multi-Agent Coordinator<br/>(Google ADK Engine)"]
            ResumeParser["Document Parser<br/>(pypdf / python-docx)"]
            ResumeAgentEngine["Private Resume Agent<br/>(Local Gemma 4 Client)"]
            JobScoutEngine["Job Scout Agent<br/>(Mock / Adzuna)"]
            SkillPlannerEngine["Skill Builder Agent<br/>(Hybrid / Deterministic)"]
            PrivacyGuardModule["Privacy Guard<br/>(assert_cloud_safe)"]

            StreamlitServer <--> CoordEngine
            CoordEngine <--> ResumeAgentEngine
            CoordEngine <--> JobScoutEngine
            CoordEngine <--> SkillPlannerEngine
            ResumeParser --> ResumeAgentEngine
            SkillPlannerEngine --> PrivacyGuardModule
        end

        subgraph StandaloneProfile ["Optional: Standalone Profile (--profile standalone)"]
            OllamaContainer["🐳 Ollama Container Service<br/>(ollama/ollama:latest)"]
            OllamaVolume["💾 Named Volume<br/>(agentic_career_lab_ollama_models)"]
            OllamaContainer <--> OllamaVolume
        end
    end

    subgraph ExternalCloud ["☁ Cloud Services (Optional / With Consent)"]
        VertexAI["Google Vertex AI / Gemini API<br/>(gemini-1.5/3.6-flash / HTTPS 443)"]
        AdzunaEndpoint["Adzuna Job API<br/>(HTTPS 443)"]
    end

    Browser <-->|"HTTP :8501"| StreamlitServer
    ResumeAgentEngine <-->|"Default: HTTP :11434<br/>(host.docker.internal)"| OllamaNative
    ResumeAgentEngine -.->|"Standalone Profile: HTTP :11434"| OllamaContainer
    PrivacyGuardModule -->|"Sanitized Gaps Only (With Consent)"| VertexAI
    JobScoutEngine -->|"HTTPS"| AdzunaEndpoint

