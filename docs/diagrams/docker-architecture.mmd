    classDef cloud fill:#fdf4ff,stroke:#9333ea,stroke-width:2px;

    class Host,Browser,GrafanaUI,OllamaNative,GemmaNativeStorage host;
    class DockerCompose,AppContainer,StreamlitServer,CoordEngine,ResumeParser,ResumeAgentEngine,JobScoutEngine,SkillPlannerEngine,PrivacyGuardModule,OTelTracer container;
    class StandaloneProfile,OllamaContainer,OllamaVolume standalone;
    class ObservabilityProfile,OTelCollector,TempoServer,PrometheusServer,GrafanaServer obs;
