flowchart LR
    classDef client fill:#eff6ff,stroke:#3b82f6,stroke-width:2px,color:#1e3a8a;
    classDef coord fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#78350f;
    classDef local fill:#ecfdf5,stroke:#10b981,stroke-width:2px,color:#064e3b;
    classDef cloud fill:#f5f3ff,stroke:#8b5cf6,stroke-width:2px,color:#4c1d95;
    classDef tools fill:#fdf2f8,stroke:#ec4899,stroke-width:2px,color:#831843;

    subgraph ClientLayer ["1. Student Interface (Port 8501)"]
        direction TB
        Streamlit["🖥️ Streamlit Application<br/><b>Interactive Career Lab Shell</b>"]
        AskAI["💬 Ask Career AI Chatbox<br/><b>Multi-Turn Guidance & Actions</b>"]
        Streamlit <--> AskAI
    end

    subgraph CoordLayer ["2. Orchestration & Google ADK Integration"]
        direction TB
        Orchestrator["🤖 CareerChatOrchestrator<br/><b>Intent Classification & Tool Dispatch</b>"]
        ADK["📦 Google ADK Coordinator<br/><b>Registered Specialist Agents & Tools</b>"]
        AskAI <--> Orchestrator
        Orchestrator <--> ADK
    end

    subgraph LocalAI ["3. Local AI & Privacy Zone (Host Ollama)"]
        direction TB
        Gemma["🦙 Local Gemma 4: 12B<br/><b>Token Streaming (httpx.stream)</b>"]
        ResumeAgent["📄 Private Resume Agent<br/><b>Evidence Extraction from Text</b>"]
        Gemma <--> ResumeAgent
        Orchestrator <-->|Local Stream| Gemma
        ADK <-->|Structured Evidence Only| ResumeAgent
    end

    subgraph SpecialistAgents ["4. Grounded Career Tools & Agents"]
        direction TB
        JobScout["💼 Job Scout Agent<br/><b>Opportunity Search & Requirements</b>"]
        SkillBuilder["🔍 Skill Builder Agent<br/><b>Deterministic Skill Gap Breakdown</b>"]
        Catalog["📚 Resource Catalog<br/><b>104 Vetted Learning Resources</b>"]
        ADK <--> JobScout
        ADK <--> SkillBuilder
        SkillBuilder <--> Catalog
    end

    subgraph CloudLayer ["5. Optional Cloud Reasoning (Explicit Consent Only)"]
        direction TB
        ConsentCheck{"🛡️ Consent Guard<br/>cloud_consent=True?"}
        Gemini["☁️ Gemini Flash<br/><b>Advanced Roadmap Synthesis</b>"]
        OfflinePlanner["⚙️ Deterministic Planner<br/><b>Offline Local Fallback</b>"]
        ConsentCheck -->|Approved| Gemini
        ConsentCheck -->|Declined / Default| OfflinePlanner
        SkillBuilder <--> ConsentCheck
    end

    class Streamlit,AskAI client;
    class Orchestrator,ADK coord;
    class Gemma,ResumeAgent local;
    class JobScout,SkillBuilder,Catalog tools;
    class ConsentCheck,Gemini,OfflinePlanner cloud;
